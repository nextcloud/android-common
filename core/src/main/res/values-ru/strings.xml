<resources>
    <!-- relative time less than 1 minute using the term: Now -->
    <string name="date_formatting_now">Сейчас</string>
    <!-- relative time in minutes, less than 1 hour, i.e. 1m, 5m, 59m -->
    <plurals name="date_formatting_relative_minutes">
        <item quantity="one">%dмин</item>
        <item quantity="few">%dмин</item>
        <item quantity="many">%dмин</item>
        <item quantity="other">%dмин</item>
    </plurals>
    <!-- relative time in hours, less than 1 day, i.e. 1h, 5h, 23h -->
    <plurals name="date_formatting_relative_hours">
        <item quantity="one">%dч</item>
        <item quantity="few">%dч</item>
        <item quantity="many">%dч</item>
        <item quantity="other">%dч</item>
    </plurals>

    <string name="ecosystem_null_account">Аккаунт отсутствует. Не удается открыть приложение.</string>
    <string name="ecosystem_invalid_account">Недопустимый формат аккаунта. Должен быть указан адрес электронной почты.</string>
    <string name="ecosystem_app_not_found">Приложение не установлено. Перенаправление в магазин…</string>
    <string name="ecosystem_store_open_failed">Не удается открыть App Store. Пожалуйста, установите приложение вручную.</string>
</resources>
